#!/bin/bash
#PBS -P gv90
#PBS -q copyq
#PBS -l walltime=10:00:00
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l storage=gdata/gv90+gdata/xp65
#PBS -j oe
#PBS -N atl20_v005

set -euo pipefail
module purge
module use /g/data/xp65/public/modules
module load conda/analysis3-26.02

cd "${PBS_O_WORKDIR:-$PWD}"
DEST="${ATL20_DEST_ROOT:-/g/data/gv90/da1339/SeaIce/ICESat2/ATL20/V005}"
WORKERS="${ATL20_WORKERS:-4}"
MANIFEST="${DEST}/atl20_v005_manifest.tsv"

python -u scripts/downloading/download_icesat2_atl20.py   --dest-root "${DEST}"   --workers "${WORKERS}"   --manifest "${MANIFEST}"
