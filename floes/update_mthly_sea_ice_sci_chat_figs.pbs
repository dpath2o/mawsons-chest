#!/bin/bash
#PBS -P jk72
#PBS -q normal
#PBS -l walltime=05:00:00
#PBS -l ncpus=8
#PBS -l mem=64GB
#PBS -l storage=gdata/gv90+scratch/gv90+gdata/jk72+gdata/xp65+gdata/rt52
#PBS -j oe
#PBS -N floes_mthly_sic

# Usage:
#   # First update observations through the network-enabled copy queue:
#   qsub ./download_observations.pbs
#
#   # After that job completes, run processing/figures:
#   cd /path/to/mawsons-chest/floes
#   qsub ./update_mthly_sea_ice_sci_chat_figs.pbs
#
# To override the PBS project without editing this file:
#   qsub -P <project> ./update_mthly_sea_ice_sci_chat_figs.pbs
#
# To override runtime options:
#   qsub -v FLOES_YEAR=2026,FLOES_MONTH=8,FLOES_SEAICE_ROOT=/g/data/gv90/da1339/SeaIce,FLOES_ERA5_ROOT=/g/data/rt52 ./update_mthly_sea_ice_sci_chat_figs.pbs

set -euo pipefail

module purge
module use /g/data/xp65/public/modules
# Pin floes processing to the last known-good PyGMT 0.15 environment.
module load conda/analysis3-26.02

cd "${PBS_O_WORKDIR:-$PWD}"

PROJECT="${PROJECT:-${PBS_PROJECT:-gv90}}"
GADI_USER="${GADI_USER:-${USER}}"
FLOES_GADI_BASE="${FLOES_GADI_BASE:-/g/data/gv90/wrh581}"
FLOES_SEAICE_ROOT="${FLOES_SEAICE_ROOT:-/g/data/gv90/da1339/SeaIce}"
FLOES_ERA5_ROOT="${FLOES_ERA5_ROOT:-/g/data/rt52}"
FLOES_NSIDC_DAILY_BASE="${FLOES_NSIDC_DAILY_BASE:-/g/data/gv90/da1339/SeaIce}"

export OMP_NUM_THREADS=1
export PYTHONPATH="$(dirname "$PWD"):${PYTHONPATH:-}"

ARGS=(--project "$PROJECT" --user "$GADI_USER" --gadi-base "$FLOES_GADI_BASE" --seaice-root "$FLOES_SEAICE_ROOT" --era5-root "$FLOES_ERA5_ROOT")

if [[ -n "${FLOES_YEAR:-}" ]]; then
    ARGS+=(--year "$FLOES_YEAR")
fi
if [[ -n "${FLOES_MONTH:-}" ]]; then
    ARGS+=(--month "$FLOES_MONTH")
fi
if [[ -n "${FLOES_NSIDC_DAILY_BASE:-}" ]]; then
    ARGS+=(--nsidc-daily-base "$FLOES_NSIDC_DAILY_BASE")
fi
if [[ "${FLOES_SKIP_WILL_SUITE:-0}" == "1" ]]; then
    ARGS+=(--skip-will-suite)
fi
if [[ "${FLOES_STRICT:-0}" == "1" ]]; then
    ARGS+=(--strict)
fi
if [[ "${FLOES_VERBOSE:-0}" == "1" ]]; then
    ARGS+=(--verbose)
fi

python -u scripts/update_mthly_sea_ice_sci_chat_figs.py "${ARGS[@]}"
