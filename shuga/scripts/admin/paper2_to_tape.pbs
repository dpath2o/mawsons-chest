#!/bin/bash
#PBS -P gv90
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l jobfs=1GB
#PBS -l walltime=10:00:00
#PBS -l storage=gdata/gv90+massdata/gv90
#PBS -lother=mdss
#PBS -j oe

set -euo pipefail

SRCROOT="/g/data/gv90/da1339/afim_output"
STAGE="/g/data/gv90/da1339/tape_stage"

NAME="paper2_20260906"
ARCHIVE="${STAGE}/${NAME}.tar"
CHECKSUM="${ARCHIVE}.sha256"

REMOTE="da1339/AFIM_backup/paper2"

mkdir -p "$STAGE"

echo "=== CREATING PAPER 2 TAR ==="

tar -cf "$ARCHIVE" -C "$SRCROOT" --exclude='./paper1' --exclude='./paper3' --exclude='./frcg-exp01' --exclude='./future_work' .

echo
echo "=== ARCHIVE ==="
ls -lh "$ARCHIVE"

echo
echo "=== SHA256 ==="
sha256sum "$ARCHIVE" | tee "$CHECKSUM"

echo
echo "=== MASSDATA ==="
mdss -P gv90 mkdir -p "$REMOTE"

mdss -P gv90 put "$ARCHIVE" "${REMOTE}/${NAME}.tar"

mdss -P gv90 put "$CHECKSUM" "${REMOTE}/${NAME}.tar.sha256"

echo
echo "=== MASSDATA CONTENTS ==="
mdss -P gv90 dmls -ltrh "$REMOTE"

echo
echo "=== COMPLETE ==="